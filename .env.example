# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_ variables are sent to the browser; keep secrets out of them.

# Public site origin, no trailing slash. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=

# WhatsApp contact number, digits only in international format (e.g. 233XXXXXXXXX). Public.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase project URL (https://<ref>.supabase.co). Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_..., or the legacy anon key). Public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Vercel sends it as a Bearer token to cron routes. When set, /api/keepalive rejects other callers.
CRON_SECRET=
