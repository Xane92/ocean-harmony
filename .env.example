# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_ variables are sent to the browser; keep secrets out of them.

# Public site origin, no trailing slash. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=

# WhatsApp contact number, digits only in international format (e.g. 233XXXXXXXXX). Public.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Sanity (Phase 3). Project ID and dataset are public identifiers.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Sanity API version date, e.g. the date the schema was last reviewed (YYYY-MM-DD).
NEXT_PUBLIC_SANITY_API_VERSION=

# Sanity read token for draft previews. Server only, secret.
SANITY_API_READ_TOKEN=
# Shared secret that the Sanity webhook sends to the revalidation route. Server only, secret.
SANITY_REVALIDATE_SECRET=
